#!/usr/bin/env zsh
# herdr / herdr-app のペインで IDE レイアウトを組む
# 使い方: ペインでプロジェクトディレクトリに移動して ide [レイアウト] [エージェント...]
# 引数なしはfzfで選択（プレビュー付き）
# herdr: 分割ペインのcwdは実行ペインを引き継ぐ(new_cwd=follow)。split --ratio は「元ペインが保持する割合」
# herdr-app: 分割の比率は指定できず常に半分になる

show_preview() {
  case "$1" in
    default-quad*)
      cat <<'EOF'
┌───────────────────┬─────────┐
│                   │         │
│                   │ term 1  │
│      term 0       │         │
│                   │         │
├───────┬──────┬────┴─┬───────┤
│term 2 │term 3│term 4│term 5 │
└───────┴──────┴──────┴───────┘
  左70%              右30%
  下段は25%ずつ4分割

EOF
      ;;
    default*)
      cat <<'EOF'
┌───────────────────┬─────────┐
│                   │         │
│                   │ term 1  │
│      term 0       │         │
│                   │         │
├───────────────────┴─────────┤
│           term 2            │
└─────────────────────────────┘
  左70%              右30%

EOF
      ;;
    ai-single*)
      cat <<'EOF'
┌───────────────────┬─────────┐
│                   │         │
│                   │ c / cx  │
│       term        │         │
│                   │         │
├───────────────────┴─────────┤
│           terminal          │
└─────────────────────────────┘
  左70%              右30%

EOF
      ;;
    ai-dual*)
      cat <<'EOF'
┌───────────────────┬─────────┐
│                   │ c / cx  │
│                   │ (上段)  │
│       term        ├─────────┤
│                   │ c / cx  │
│                   │ (下段)  │
├───────────────────┴─────────┤
│           terminal          │
└─────────────────────────────┘
  左70%              右30%
  上下それぞれ c / cx を選択

EOF
      ;;
    pair-ai*)
      cat <<'EOF'
┌───────────┬───────────┬─────┐
│           │           │     │
│ term 1    │ term 2    │c/cx │
│           │           │     │
├───────────┴───────────┴─────┤
│          terminal           │
└─────────────────────────────┘
  左40%      中40%    右20%

EOF
      ;;
    pair*)
      cat <<'EOF'
┌──────────────┬──────────────┐
│              │              │
│    term 1    │    term 2    │
│              │              │
├──────────────┴──────────────┤
│           terminal          │
└─────────────────────────────┘
  左50%            右50%

EOF
      ;;
    grid-full*)
      cat <<'EOF'
┌─────────────────────────────┐
│           term 0            │
├─────────┬─────────┬─────────┤
│ term 1  │ term 2  │ term 3  │
├─────────┼─────────┼─────────┤
│ term 4  │ term 5  │ term 6  │
└─────────┴─────────┴─────────┘

EOF
      ;;
    grid*)
      cat <<'EOF'
┌─────────────────────────────┐
│           term 0            │
├─────────┬─────────┬─────────┤
│ term 1  │ term 2  │ term 3  │
└─────────┴─────────┴─────────┘

EOF
      ;;
  esac
}

# --preview モードの場合（fzfから呼ばれる）
if [[ "$1" == "--preview" ]]; then
  show_preview "$2"
  exit 0
fi


if [[ -z "$HERDR_PANE_ID" && -z "$HC_TERMINAL_ID" ]]; then
  echo "herdr か herdr-app のペイン内で実行してください" >&2
  exit 1
fi

select_agent() {
  local agents="cx	claude --enable-auto-mode"

  local selected
  selected=$(echo "$agents" | fzf \
    --height=20% \
    --layout=reverse \
    --delimiter=$'\t' \
    --with-nth=1.. \
    --header="エージェントを選択" \
    --no-info)

  if [[ -z "$selected" ]]; then
    return 1
  fi

  echo "$selected" | cut -f1
}

# --- herdr ---
pane_id() { grep -o '"pane_id":"[^"]*"' | head -1 | cut -d'"' -f4 }
sp() { herdr pane split "$1" --direction "$2" --ratio "$3" --no-focus | pane_id }
run_in() { herdr pane run "$1" "$2" >/dev/null }

layout_herdr() {
  local p1=$HERDR_PANE_ID
  case "$1" in
    default)
      # 下段(15%)と右30%を作成
      sp $p1 down 0.85 >/dev/null
      sp $p1 right 0.70 >/dev/null
      ;;
    default-quad)
      # 下段(15%)を作成して25%ずつ4分割、右30%も作成
      local bottom=$(sp $p1 down 0.85)
      sp $p1 right 0.70 >/dev/null
      local b2=$(sp $bottom right 0.25)
      local b3=$(sp $b2 right 0.34)
      sp $b3 right 0.5 >/dev/null
      ;;
    ai-single)
      sp $p1 down 0.85 >/dev/null
      local ai_pane=$(sp $p1 right 0.70)
      sleep 1
      run_in $ai_pane "$2"
      ;;
    ai-dual)
      sp $p1 down 0.85 >/dev/null
      local ai_pane=$(sp $p1 right 0.70)
      local bottom_pane=$(sp $ai_pane down 0.5)
      sleep 1
      run_in $ai_pane "$2"
      run_in $bottom_pane "$3"
      ;;
    pair)
      sp $p1 down 0.85 >/dev/null
      sp $p1 right 0.50 >/dev/null
      ;;
    pair-ai)
      sp $p1 down 0.85 >/dev/null
      local ai_pane=$(sp $p1 right 0.80)
      sp $p1 right 0.50 >/dev/null
      sleep 1
      run_in $ai_pane "$2"
      ;;
    grid)
      local bottom=$(sp $p1 down 0.75)
      local b2=$(sp $bottom right 0.34)
      sp $b2 right 0.5 >/dev/null
      ;;
    grid-full)
      local row3=$(sp $p1 down 0.75)
      local r3b=$(sp $row3 right 0.34)
      sp $r3b right 0.5 >/dev/null
      local row2=$(sp $p1 down 0.67)
      local r2b=$(sp $row2 right 0.34)
      sp $r2b right 0.5 >/dev/null
      ;;
  esac
}

# --- herdr-app ---
# ペインを分割し「pane terminal」を返す
app_split() {
  # pane.split は作業フォルダを指定できず、作ったばかりのペインを分割すると別の場所で開く
  herdr-app do pane.focus --pane "$1" >/dev/null
  herdr-app do terminal.open --folder "$PWD" --place "$2" |
    grep -oE '"(pane|terminal)": *"[^"]*"' | cut -d'"' -f4 | tr '\n' ' '
}

layout_herdr_app() {
  local p1
  p1=$(herdr-app status | sed -n 's/.*"focused_pane": *"\([^"]*\)".*/\1/p')
  local b b2 b3 r2 r3 ai_pane ai_terminal bottom_terminal
  case "$1" in
    default|pair)
      app_split "$p1" down >/dev/null
      app_split "$p1" right >/dev/null
      ;;
    default-quad)
      read -r b _ < <(app_split "$p1" down)
      app_split "$p1" right >/dev/null
      read -r b2 _ < <(app_split "$b" right)
      app_split "$b" right >/dev/null
      app_split "$b2" right >/dev/null
      ;;
    ai-single)
      app_split "$p1" down >/dev/null
      read -r _ ai_terminal < <(app_split "$p1" right)
      hc send "$ai_terminal" "$2" >/dev/null
      ;;
    ai-dual)
      app_split "$p1" down >/dev/null
      read -r ai_pane ai_terminal < <(app_split "$p1" right)
      read -r _ bottom_terminal < <(app_split "$ai_pane" down)
      hc send "$ai_terminal" "$2" >/dev/null
      hc send "$bottom_terminal" "$3" >/dev/null
      ;;
    pair-ai)
      app_split "$p1" down >/dev/null
      read -r _ ai_terminal < <(app_split "$p1" right)
      app_split "$p1" right >/dev/null
      hc send "$ai_terminal" "$2" >/dev/null
      ;;
    grid)
      read -r b _ < <(app_split "$p1" down)
      read -r b2 _ < <(app_split "$b" right)
      app_split "$b2" right >/dev/null
      ;;
    grid-full)
      read -r r3 _ < <(app_split "$p1" down)
      read -r b3 _ < <(app_split "$r3" right)
      app_split "$b3" right >/dev/null
      read -r r2 _ < <(app_split "$p1" down)
      read -r b2 _ < <(app_split "$r2" right)
      app_split "$b2" right >/dev/null
      ;;
  esac
  herdr-app do pane.focus --pane "$p1" >/dev/null
}

# 足りないエージェントを選んでから、今いる側（herdr / herdr-app）で組む
apply_layout() {
  local layout="$1" agent1="$2" agent2="$3"
  case "$layout" in
    ai-single|pair-ai)
      [[ -n "$agent1" ]] || agent1=$(select_agent) || return 0
      ;;
    ai-dual)
      if [[ -z "$agent1" ]]; then
        echo "上段エージェント:"
        agent1=$(select_agent) || return 0
      fi
      if [[ -z "$agent2" ]]; then
        echo "下段エージェント:"
        agent2=$(select_agent) || return 0
      fi
      ;;
  esac
  if [[ -n "$HERDR_PANE_ID" ]]; then
    layout_herdr "$layout" "$agent1" "$agent2"
  else
    layout_herdr_app "$layout" "$agent1" "$agent2"
  fi
}

layouts=(default default-quad ai-single ai-dual pair pair-ai grid grid-full)

# 引数があればそのまま実行
if [[ -n "$1" ]]; then
  if (( ! ${layouts[(Ie)$1]} )); then
    echo "Unknown layout: $1"
    exit 1
  fi
  apply_layout "$@"
  exit 0
fi

# fzfで選択
selected=$(print -l $layouts | fzf \
  --height=40% \
  --layout=reverse \
  --preview="$0 --preview {1}" \
  --preview-window=right:40% \
  --header="レイアウトを選択" \
  --no-info)

[[ -n "$selected" ]] && apply_layout "$selected"

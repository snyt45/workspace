#!/usr/bin/env bash
# ファイルを Obsidian で開く。使い方: obs <ファイルのパス>
# パスを含む vault が Obsidian に登録されていれば、その vault で開く
[ -n "$1" ] || { echo "usage: obs <file>" >&2; exit 1; }
abs=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
open "obsidian://open?path=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$abs")"
